APP_ENV=development
DATABASE_URL=sqlite:///./data/legosell.db
# Vercel/Neon can use POSTGRES_URL instead of DATABASE_URL.
# POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
UPLOAD_DIR=./data/uploads
MAX_UPLOADS_PER_LISTING=20
# Local development uses the backend on port 8000. Vercel production uses /api automatically.
VITE_API_URL=http://localhost:8000
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
